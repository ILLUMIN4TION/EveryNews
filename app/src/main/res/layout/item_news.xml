<?xml version="1.0" encoding="utf-8"?>
<!-- ★★★ MaterialCardView -> ConstraintLayout으로 변경 ★★★ -->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp"
    android:background="?attr/colorSurfaceContainerLowest"> <!-- 배경색을 테마 표면색으로 -->

    <!-- ★★★ ImageView -> ShapeableImageView로 변경하고, ShapeAppearance 적용 ★★★ -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/iv_default_news_thumbnail"
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:scaleType="centerCrop"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:importantForAccessibility="no"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.CornerSize8dp"
        tools:src="@tools:sample/avatars" />

    <!-- 텍스트 영역 (오른쪽) -->
    <LinearLayout
        android:id="@+id/text_content_area"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/iv_default_news_thumbnail"
        app:layout_constraintEnd_toStartOf="@id/imv_news_scrap"
        app:layout_constraintTop_toTopOf="@id/iv_default_news_thumbnail"
        app:layout_constraintBottom_toBottomOf="@id/iv_default_news_thumbnail"
        app:layout_constraintHorizontal_bias="0">

        <TextView
            android:id="@+id/tv_default_news_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="News Title Goes Here: A very long title that might span across multiple lines." />

        <TextView
            android:id="@+id/tv_default_news_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp"
            tools:text="News description goes here. This is a sample text for the description of the news article. It provides a brief summary." />



    </LinearLayout>

    <!-- 스크랩 버튼 (오른쪽 상단) -->
    <ImageView
        android:id="@+id/imv_news_scrap"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="8dp"
        android:src="@drawable/ic_bookmark"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/iv_default_news_thumbnail"
        app:tint="?attr/colorOnSurfaceVariant"
        android:contentDescription="스크랩 버튼" />

</androidx.constraintlayout.widget.ConstraintLayout>

